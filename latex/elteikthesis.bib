@InProceedings{coq1st,
	author="Forster, Yannick
	and Kirst, Dominik
	and Wehr, Dominik",
	editor="Artemov, Sergei
	and Nerode, Anil",
	title="Completeness Theorems for First-Order Logic Analysed in Constructive Type Theory",
	booktitle="Logical Foundations of Computer Science",
	year="2020",
	publisher="Springer International Publishing",
	address="Cham",
	pages="47--74",
	abstract="We study various formulations of the completeness of first-order logic phrased in constructive type theory and mechanised in the Coq proof assistant. Specifically, we examine the completeness of variants of classical and intuitionistic natural deduction and sequent calculi with respect to model-theoretic, algebraic, and game semantics. As completeness with respect to standard model-theoretic semantics is not readily constructive, we analyse the assumptions necessary for particular syntax fragments and discuss non-standard semantics admitting assumption-free completeness. We contribute a reusable Coq library for first-order logic containing all results covered in this paper.",
	isbn="978-3-030-36755-8",
	doi="10.1007/978-3-030-36755-8_4"
}

